<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050508">

    <!-- Decorative bubbles -->
    <View
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_gravity="top|end"
        android:layout_marginEnd="-60dp"
        android:layout_marginTop="-40dp"
        android:background="@drawable/bubble_large"
        android:alpha="0.5" />

    <View
        android:layout_width="380dp"
        android:layout_height="380dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="-80dp"
        android:layout_marginBottom="-80dp"
        android:background="@drawable/bubble_large"
        android:alpha="0.45" />

    <View
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="-40dp"
        android:background="@drawable/bubble_medium"
        android:alpha="0.35" />

    <!-- Scrollable form -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="56dp"
            android:paddingBottom="48dp">

            <!-- INKSLOT Brand -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="40dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="INK"
                    android:textSize="34sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:letterSpacing="0.04" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SLOT"
                    android:textSize="34sp"
                    android:textStyle="bold"
                    android:textColor="#606080"
                    android:letterSpacing="0.04" />

            </LinearLayout>

            <!-- Frosted card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="28dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Create Account"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Register a new artist account"
                    android:textSize="14sp"
                    android:textColor="#7070A0"
                    android:layout_marginBottom="28dp" />

                <!-- Error -->
                <TextView
                    android:id="@+id/tvError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#FF7070"
                    android:textSize="13sp"
                    android:visibility="gone"
                    android:background="#15FF0000"
                    android:padding="12dp"
                    android:layout_marginBottom="12dp"
                    android:gravity="center" />

                <!-- Success -->
                <TextView
                    android:id="@+id/tvSuccess"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#6FDCA0"
                    android:textSize="13sp"
                    android:visibility="gone"
                    android:background="#1500FF60"
                    android:padding="12dp"
                    android:layout_marginBottom="12dp"
                    android:gravity="center" />

                <!-- Full Name -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="FULL NAME"
                    android:textSize="11sp"
                    android:textColor="#606080"
                    android:letterSpacing="0.12"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/etFullName"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:inputType="textPersonName"
                    android:hint="Full name"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:background="@drawable/input_bg"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:layout_marginBottom="20dp" />

                <!-- Email -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="EMAIL ADDRESS"
                    android:textSize="11sp"
                    android:textColor="#606080"
                    android:letterSpacing="0.12"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:inputType="textEmailAddress"
                    android:hint="artist@example.com"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:background="@drawable/input_bg"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:layout_marginBottom="20dp" />

                <!-- Password -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PASSWORD"
                    android:textSize="11sp"
                    android:textColor="#606080"
                    android:letterSpacing="0.12"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:inputType="textPassword"
                    android:hint="Min. 6 characters"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:background="@drawable/input_bg"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:layout_marginBottom="28dp" />

                <!-- Register button -->
                <Button
                    android:id="@+id/btnRegister"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="Create Account"
                    android:textColor="#000000"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_white"
                    android:stateListAnimator="@null"
                    android:layout_marginBottom="20dp" />

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#18FFFFFF"
                    android:layout_marginBottom="20dp" />

                <TextView
                    android:id="@+id/tvGoToLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Already have an account? Log in"
                    android:textColor="#50506A"
                    android:textSize="13sp"
                    android:layout_gravity="center_horizontal" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</FrameLayout>
